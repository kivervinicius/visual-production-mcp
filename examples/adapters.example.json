{
  "google-flow": {
    "image.generate": {
      "tool": "REPLACE_WITH_REAL_IMAGE_TOOL",
      "arguments": {
        "prompt": { "from": "input.prompt" },
        "aspectRatio": { "from": "input.aspectRatio" },
        "referenceImages": { "from": "input.referenceImages" },
        "confirmCreditSpend": { "literal": true }
      },
      "resultIdPaths": ["jobId", "operationId", "data.jobId"],
      "statusPaths": ["status", "state", "data.status"]
    },
    "video.frames": {
      "tool": "REPLACE_WITH_REAL_FRAMES_TOOL",
      "arguments": {
        "prompt": { "from": "input.prompt" },
        "startFrame": { "from": "input.startFrame" },
        "aspectRatio": { "from": "input.aspectRatio" },
        "durationSeconds": { "from": "input.durationSeconds" },
        "confirmCreditSpend": { "literal": true }
      },
      "resultIdPaths": ["jobId", "operationId", "data.jobId"],
      "statusPaths": ["status", "state", "data.status"]
    },
    "character.create": {
      "tool": "REPLACE_WITH_REAL_CHARACTER_TOOL",
      "arguments": {
        "characterId": { "from": "input.characterId" },
        "source": { "from": "input.source" }
      }
    },
    "scene.compose": {
      "tool": "REPLACE_WITH_REAL_SCENE_TOOL",
      "arguments": {
        "clips": { "from": "input.clips" }
      }
    }
  }
}